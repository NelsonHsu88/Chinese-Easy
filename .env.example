# Copy to .env and fill in from the Supabase dashboard:
#   Project Settings → API → "Project URL" and the public API key
#   (labelled "anon"/"public" on older dashboards, "publishable" on newer ones).
#
# Committed on purpose: it records which variables the app expects, so a fresh
# clone knows what to set. Never put real values in this file — .env is the one
# that is gitignored.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The EXPO_PUBLIC_ prefix inlines a value into the shipped JS bundle. Never put
# the Supabase service_role key here or in .env — it bypasses Row Level
# Security and belongs on a server, or nowhere.

# ── AdMob ad unit ids ────────────────────────────────────────────────────────
# From AdMob → Apps → Chinese Easy → Ad units. One per format per platform.
#
# Leaving these empty is a supported state: every placement simply renders
# nothing, so a release built before the ids exist shows no adverts rather than
# breaking. They are safe as EXPO_PUBLIC_ values — an ad unit id names inventory
# and authorises nothing.
#
# These are used by RELEASE builds only. A development build always serves
# Google's test ads and never reads these, so testing cannot generate invalid
# traffic against a live account (see src/lib/ads/adUnits.ts).
#
# The two *App* ids are separate and belong to the native SDK — they live in the
# top-level "react-native-google-mobile-ads" block in app.json, which currently
# holds Google's published sample App ids.

EXPO_PUBLIC_ADMOB_ANDROID_BANNER=
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED=
EXPO_PUBLIC_ADMOB_IOS_BANNER=
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL=
EXPO_PUBLIC_ADMOB_IOS_REWARDED=

# ─── Supabase RLS integration test (scripts/testRls.mjs) ─────────────────────
# Two ordinary confirmed accounts, created by hand under Authentication -> Users.
# Deliberately NOT a service_role key: an admin key bypasses RLS, so testing
# with one would prove the opposite of what is wanted. See supabase/README.md.
#
# Two rules for these, because they are real credentials on a real project:
#
#  1. **Give them different passwords.** The whole test is that A cannot reach
#     B's rows; one shared password means one leak compromises both sides of it.
#  2. **Prefer a separate Supabase project for testing.** These are ordinary
#     accounts, so they authorise only their own rows — but a test credential
#     that grants nothing at all on production is strictly better, and it costs
#     one free project.
#
# If these ever reach CI, they are CI secrets — never a committed file.

TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
